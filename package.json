{
  "name": "yt-transcript-extractor",
  "version": "1.0.0",
  "description": "Extract YouTube transcripts (manual + auto-generated captions) as text, JSON, SRT or VTT via a REST API or CLI.",
  "type": "module",
  "main": "server.js",
  "bin": {
    "yt-transcript": "./extract.js"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "extract": "node extract.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "youtube",
    "transcript",
    "captions",
    "subtitles",
    "srt",
    "vtt"
  ],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0"
  }
}
