# Copy to .env and adjust. Every value is optional; defaults are shown.

PORT=3000
HOST=0.0.0.0

# Comma-separated list of allowed browser origins, or * for any.
CORS_ORIGIN=*

# Set to 1 (or "true") when running behind a reverse proxy / load balancer
# so rate limiting sees the real client IP.
TRUST_PROXY=

# API rate limit per client IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Upstream (YouTube) request settings.
YT_TIMEOUT_MS=15000
YT_RETRIES=2

# In-memory cache for track lists and transcripts.
CACHE_TTL_MS=600000
CACHE_MAX_ENTRIES=200
